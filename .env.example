# API key de Resend (https://resend.com/api-keys)
RESEND_API_KEY=

# Remitente. En modo prueba Resend solo permite "Arcade Vault <onboarding@resend.dev>"
RESEND_FROM_EMAIL=

# Destinatario de los mensajes. En modo prueba solo puede ser el correo del dueño
# de la cuenta de Resend; para otro destinatario hay que verificar un dominio.
CONTACT_TO_EMAIL=
